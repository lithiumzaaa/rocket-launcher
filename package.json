{
  "name": "rocket-launcher",
  "productName": "Rocket Launcher",
  "version": "0.4.0",
  "description": "Lightweight unified game launcher",
  "author": "Tristin Dawson",
  "main": "./out/main/index.js",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "build:win": "npm run typecheck && electron-vite build && electron-builder --win --x64 --publish never",
    "release": "node scripts/release.mjs"
  },
  "//": "Everything the renderer uses is bundled by Vite and the main process only needs Electron/Node, so there are no runtime dependencies: nothing from node_modules ships in the installer.",
  "devDependencies": {
    "@fontsource-variable/inter": "^5.1.0",
    "@types/node": "^22.9.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "lucide-react": "^0.460.0",
    "postcss": "^8.4.49",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "tailwindcss": "^3.4.15",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "zustand": "^5.0.1"
  },
  "dependencies": {
    "electron-updater": "^6.3.9"
  }
}
